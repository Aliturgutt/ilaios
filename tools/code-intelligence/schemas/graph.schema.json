{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ilaios:code-intelligence:graph:v1",
  "title": "ILAIOS Code Intelligence Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_revision",
    "generation_id",
    "nodes",
    "edges",
    "coverage",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": "ilaios-code-intelligence-graph-v1"
    },
    "repository_revision": {
      "type": "string"
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "kind", "label", "certainty"],
        "properties": {
          "node_id": {"type": "string"},
          "kind": {
            "type": "string",
            "enum": ["file", "symbol", "external_dependency"]
          },
          "label": {"type": "string"},
          "path": {"type": ["string", "null"]},
          "qualified_name": {"type": ["string", "null"]},
          "symbol_type": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "public": {"type": ["boolean", "null"]},
          "certainty": {
            "type": "string",
            "enum": ["known", "inferred", "unknown"]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "source_id",
          "target_id",
          "kind",
          "certainty",
          "evidence"
        ],
        "properties": {
          "edge_id": {"type": "string"},
          "source_id": {"type": "string"},
          "target_id": {"type": "string"},
          "kind": {
            "type": "string",
            "enum": [
              "contains",
              "parent",
              "imports",
              "declares_dependency",
              "depends_on",
              "calls"
            ]
          },
          "certainty": {
            "type": "string",
            "enum": ["known", "inferred", "unknown"]
          },
          "evidence": {"type": "string"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_files",
        "analyzable_source_files",
        "semantic_files",
        "structural_files",
        "generated_files",
        "unknown_facts"
      ],
      "properties": {
        "total_files": {"type": "integer", "minimum": 0},
        "analyzable_source_files": {"type": "integer", "minimum": 0},
        "semantic_files": {"type": "integer", "minimum": 0},
        "structural_files": {"type": "integer", "minimum": 0},
        "generated_files": {"type": "integer", "minimum": 0},
        "unknown_facts": {"type": "integer", "minimum": 0}
      }
    },
    "unknowns": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
