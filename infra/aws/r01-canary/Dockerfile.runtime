FROM python:3.12.13-alpine3.22@sha256:a190708a2dec1bd18b1decb539f8e8f5407abaa9bf39cacda583f7f8c11db322

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/ilaios

WORKDIR /opt/ilaios

RUN addgroup -S -g 1000 ilaios \
    && adduser -S -D -H -u 1000 -G ilaios ilaios \
    && mkdir -p /var/lib/ilaios /tmp/ilaios \
    && chown -R 1000:1000 /var/lib/ilaios /tmp/ilaios /opt/ilaios

COPY --chown=1000:1000 apps /opt/ilaios/apps
COPY --chown=1000:1000 packages /opt/ilaios/packages
COPY --chown=1000:1000 services /opt/ilaios/services
COPY --chown=1000:1000 src /opt/ilaios/src

RUN python -m compileall -q /opt/ilaios \
    && python -c "import sqlite3; import services.deployment.runtime; print('R01_RUNTIME_IMPORT_OK')"

USER 1000:1000

ENTRYPOINT ["python", "-m", "services.deployment.runtime"]
