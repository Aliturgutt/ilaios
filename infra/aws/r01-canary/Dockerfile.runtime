FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/ilaios \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt/ilaios

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends libgomp1 openssl; \
    rm -rf /var/lib/apt/lists/*; \
    openssl version

RUN groupadd --system --gid 1000 ilaios \
    && useradd --system --uid 1000 --gid 1000 --no-create-home ilaios \
    && mkdir -p /var/lib/ilaios /tmp/ilaios /opt/ilaios/models/rag14-e5 /opt/ilaios/infra/rag \
    && chown -R 1000:1000 /var/lib/ilaios /tmp/ilaios

COPY .github/requirements/rag14-embedding-certification.txt /tmp/rag14-embedding-runtime.txt
RUN python -m pip install --no-cache-dir -r /tmp/rag14-embedding-runtime.txt \
    && python -m pip check \
    && python -m pip freeze --all | LC_ALL=C sort > /opt/ilaios/models/rag14-e5/runtime-python-packages.txt \
    && rm -f /tmp/rag14-embedding-runtime.txt

COPY apps /opt/ilaios/apps
COPY packages /opt/ilaios/packages
COPY services /opt/ilaios/services
COPY src /opt/ilaios/src
COPY infra/rag/multilingual-e5-small-qint8.candidate.json /opt/ilaios/infra/rag/multilingual-e5-small-qint8.candidate.json

RUN python -m services.rag14_embedding_benchmark \
      --manifest /opt/ilaios/infra/rag/multilingual-e5-small-qint8.candidate.json \
      --work-dir /opt/ilaios/models/rag14-e5 \
      --output /opt/ilaios/models/rag14-e5/build-benchmark.json \
    && python -m compileall -q /opt/ilaios \
    && python -c "from pathlib import Path; from services.rag14_embedding_provider import PinnedE5EmbeddingProvider; p=PinnedE5EmbeddingProvider(manifest_path=Path('/opt/ilaios/infra/rag/multilingual-e5-small-qint8.candidate.json'), artifact_root=Path('/opt/ilaios/models/rag14-e5')); assert p.provider_id.startswith('ilaios.embedding.multilingual-e5-small.qint8.v1@'); print('RAG14_E5_PROVIDER_OK')" \
    && find /opt/ilaios/models/rag14-e5 -type f -exec chmod 0444 {} + \
    && chmod 0444 /opt/ilaios/infra/rag/multilingual-e5-small-qint8.candidate.json \
    && python -c "import sqlite3; import services.deployment.runtime; import services.rag14_maintenance; print('R01_RUNTIME_IMPORT_OK')"

USER 1000:1000

ENTRYPOINT ["python", "-m", "services.deployment.runtime"]
