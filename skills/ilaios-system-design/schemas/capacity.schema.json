{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilaios.local/schemas/system-design/capacity.schema.json",
  "title": "ILAIOS System Design Capacity Estimate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_rps",
    "peak_rps",
    "read_rps",
    "write_rps",
    "ingress_bits_per_second",
    "egress_bits_per_second",
    "write_storage_bytes_per_day",
    "minimum_instances",
    "downtime_seconds_per_30_day_month",
    "downtime_seconds_per_year",
    "budget_headroom",
    "assumptions",
    "issues"
  ],
  "properties": {
    "base_rps": {"type": ["number", "null"], "minimum": 0},
    "peak_rps": {"type": ["number", "null"], "minimum": 0},
    "read_rps": {"type": ["number", "null"], "minimum": 0},
    "write_rps": {"type": ["number", "null"], "minimum": 0},
    "ingress_bits_per_second": {"type": ["number", "null"], "minimum": 0},
    "egress_bits_per_second": {"type": ["number", "null"], "minimum": 0},
    "write_storage_bytes_per_day": {"type": ["number", "null"], "minimum": 0},
    "minimum_instances": {"type": ["integer", "null"], "minimum": 1},
    "downtime_seconds_per_30_day_month": {"type": "number", "minimum": 0},
    "downtime_seconds_per_year": {"type": "number", "minimum": 0},
    "budget_headroom": {"type": ["number", "null"]},
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["info", "warning", "error"]},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
