{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilaios.local/schemas/system-design/architecture.schema.json",
  "title": "ILAIOS System Design Architecture Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "system_id",
    "demand",
    "nodes",
    "edges",
    "decisions",
    "risks",
    "evidence_required",
    "diagram_contract"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "system_id": {"type": "string", "minLength": 1},
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrent_users",
        "base_rps",
        "peak_rps",
        "latency_slo_ms",
        "availability_slo"
      ],
      "properties": {
        "concurrent_users": {"type": ["integer", "null"], "minimum": 0},
        "base_rps": {"type": ["number", "null"], "minimum": 0},
        "peak_rps": {"type": ["number", "null"], "minimum": 0},
        "latency_slo_ms": {"type": ["integer", "null"], "minimum": 1},
        "availability_slo": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "layer",
          "stateful",
          "failure_domain",
          "criticality"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "layer": {"type": "string", "minLength": 1},
          "stateful": {"type": "boolean"},
          "failure_domain": {"type": "string", "minLength": 1},
          "criticality": {"enum": ["low", "medium", "high", "critical"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "kind"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "dependency",
              "data_flow",
              "control_flow",
              "telemetry",
              "replication"
            ]
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "decision",
          "rationale",
          "confidence",
          "evidence_status"
        ],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["low", "medium", "high"]},
          "evidence_status": {"enum": ["heuristic", "estimated", "policy", "verified"]}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_required": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "diagram_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer_skill", "coupling"],
      "properties": {
        "consumer_skill": {"const": "ilaios-diagram-design"},
        "coupling": {"const": "schema_only"}
      }
    }
  }
}
