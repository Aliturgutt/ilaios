```yaml
capability_id: "ilaios.capability.web-factory"
schema_version: "1"
display_name: "Web Factory"
domain: "factory"
dependencies:
  - "ilaios.capability.workflow-runtime"
  - "ilaios.capability.policy-governance"
input_contracts: []
output_contracts: []
required_permissions: []
